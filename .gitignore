# ---- 依赖与构建产物 ----
node_modules/
.pnpm-store/
out/
dist/
# electron-builder 的输出目录。用通配符是因为我偶尔会用 release-012 之类的
# 备用目录并行构建（例如用户正开着上一版、原目录被占用时），
# 忘了忽略就会把 200+ MB 的安装包提交进仓库。
release/
release-*/
*.tsbuildinfo

# ---- Python 内核 ----
core/.venv/
core/dist/
core/build/
__pycache__/
*.py[cod]
.pytest_cache/
core/tests/.pytest-data/

# ---- PyInstaller / electron-builder 中间产物 ----
.cache/

# ---- 本地数据与试跑产物 ----
.docforge-data/
core/.docforge-data/
docforge-output/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# ---- 环境变量与密钥 ----
# 绝不要把 API Key 提交进仓库（内核用 Windows DPAPI 加密存储，不进仓库）
.env
.env.local
*.key
