registry=https://registry.npmmirror.com

# Electron / electron-builder 二进制走国内镜像，避免从 GitHub 拉取超时
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
node_gyp_binary_host_mirror=https://npmmirror.com/mirrors/node/

shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true

# pnpm 默认会在每次 `pnpm run` 前自动检查依赖是否最新，必要时静默跑一次 install。
# 这会让每条脚本命令都多出几秒开销，且在受限期环境下会因 spawn 被拦而直接失败。
# 依赖由开发者显式执行 `pnpm install` 维护，这里关掉自动检查。
verify-deps-before-run=false
